---
import { getCollection, render } from "astro:content";
import { useTranslations } from "../../../i18n/utils";
import "../../../styles/global.css";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.md$/, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { title_zh, description_zh, pubDate } = post.data;
const { Content } = await render(post);
const t = useTranslations("zh");
---

<!doctype html>
<html lang="zh">
    <head>
        <meta charset="UTF-8" />
        <meta name="description" content={description_zh} />
        <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="generator" content={Astro.generator} />
        <meta name="theme-color" content="#f8fafc" />
        <title>{title_zh} | Blog</title>
        
    </head>
    <body>
        <Header />
        <main class="blog-main">
            <article class="blog-article mx-auto">
                <header class="blog-post-header appear">
                    <h1>{title_zh}</h1>
                    <p class="blog-post-meta">发表于 {pubDate.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })}</p>
                </header>
                <div class="blog-content appear" style="transition-delay: 100ms;">
                    <Content />
                </div>
                <a href="/zh/blog/" class="blog-back-link appear" style="transition-delay: 200ms;">← {t("blog.back_to_list")}</a>
            </article>
        </main>
        <Footer />

        <style>
            .blog-main { padding-top: 58px; min-height: 100vh; }
            .blog-article { max-width: 760px; padding: 64px 22px 80px; }
            .blog-post-header { margin-bottom: 40px; padding-bottom: 24px; border-bottom: 1px solid var(--color-border); }
            .blog-post-header h1 { color: var(--color-heading); font-size: clamp(2.2rem, 6vw, 3.5rem); line-height: 1.05; letter-spacing: -.04em; font-weight: 760; margin-bottom: 16px; }
            .blog-post-meta { font-size: 14px; color: var(--color-text-muted); }
            .blog-content { font-size: 1.02rem; line-height: 1.75; }
            .blog-content :global(h2) { color: var(--color-heading); font-size: 1.55rem; font-weight: 700; margin-top: 44px; margin-bottom: 14px; }
            .blog-content :global(p) { margin-bottom: 24px; }
            .blog-content :global(ul), .blog-content :global(ol) { margin-bottom: 24px; padding-left: 24px; }
            .blog-content :global(li) { margin-bottom: 12px; }
            .blog-content :global(a) { color: var(--color-primary); text-decoration: underline; }
            .blog-back-link { display: inline-block; margin-top: 48px; color: var(--color-primary); font-weight: 500; transition: opacity 0.3s var(--ease-apple); }
            .blog-back-link:hover { opacity: 0.8; }
        </style>
    </body>
</html>
