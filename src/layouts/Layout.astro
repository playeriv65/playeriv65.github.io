---
import "../styles/global.css";
import { getLangFromUrl } from "../i18n/utils";

interface Props {
	title: string;
	description?: string;
}

const { title, description = "Zelin Li is a computer science student and researcher at the University of Minnesota working on efficient LLM systems." } = Astro.props;
const lang = getLangFromUrl(Astro.url);
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#f8fafc" />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={Astro.url} />
		<meta property="og:image" content="https://playeriv65.com/og.png" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content="https://playeriv65.com/og.png" />
		<title>{title}</title>
	</head>
	<body>
		<slot />

	</body>
</html>
