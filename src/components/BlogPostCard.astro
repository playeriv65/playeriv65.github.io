---
export interface Props {
    title: string;
    description: string;
    pubDate: Date;
    href: string;
}

const { title, description, pubDate, href } = Astro.props;

function formatDate(date: Date): string {
    return date.toLocaleDateString('en-US', {
        year: 'numeric',
        month: 'long',
        day: 'numeric',
    });
}
---

<a href={href} class="bento-card blog-post-card reveal-on-scroll">
    <div class="card-content">
        <div class="card-header">
            <h3 class="card-title">{title}</h3>
            <p class="card-date">Published on {formatDate(pubDate)}</p>
        </div>
        <p class="card-desc">{description}</p>
    </div>
</a>

<style>
    .blog-post-card {
        background-color: var(--card-bg);
        border-radius: 10px;
        height: auto;
        min-height: 220px;
        padding: 24px;
        display: flex;
        flex-direction: column;
        justify-content: flex-start;
        position: relative;
        overflow: hidden;
        transition: transform .18s ease, border-color .18s ease;
        border: 1px solid var(--color-border);
        text-decoration: none;
        cursor: pointer;
    }

    .blog-post-card:hover {
        transform: translateY(-2px);
        border-color: #aebbd0;
        text-decoration: none;
    }

    .card-content {
        display: flex;
        flex-direction: column;
        height: 100%;
    }

    .card-header {
        margin-bottom: 16px;
    }

    .card-title {
        font-size: 1.25rem;
        font-weight: 700;
        margin-bottom: 8px;
        letter-spacing: -0.01em;
        color: var(--color-heading);
        line-height: 1.2;
    }

    .card-date {
        font-size: .76rem;
        font-weight: 600;
        color: var(--color-primary);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin: 0;
    }

    .card-desc {
        font-size: .95rem;
        line-height: 1.5;
        color: var(--color-text-muted);
        margin: 0;
        flex-grow: 1;
    }

    /* Use global reveal-on-scroll styles */

    @media (max-width: 768px) {
        .blog-post-card {
            padding: 22px;
            min-height: 200px;
        }

        .card-title {
            font-size: 1.15rem;
        }

        .card-desc {
            font-size: .92rem;
        }
    }
</style>
