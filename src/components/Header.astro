---
import { getLangFromUrl } from "../i18n/utils";
import LanguagePicker from "./LanguagePicker.astro";

const lang = getLangFromUrl(Astro.url);
const home = lang === "en" ? "/" : "/zh/";
const labels = lang === "en"
    ? { education: "Education", research: "Research", publications: "Publications", projects: "Projects" }
    : { education: "教育", research: "研究", publications: "论文", projects: "项目" };
---

<header>
    <div class="nav-wrap">
        <a class="name" href={home}>Zelin Li</a>
        <nav aria-label="Primary navigation">
            <a href={`${home}#education`}>{labels.education}</a>
            <a href={`${home}#research`}>{labels.research}</a>
            <a href={`${home}#publications`}>{labels.publications}</a>
            <a href={`${home}#projects`}>{labels.projects}</a>
            <LanguagePicker />
        </nav>
    </div>
</header>

<style>
    header { position: fixed; inset: 0 0 auto; z-index: 20; background: rgba(255, 255, 255, .94); border-bottom: 1px solid var(--color-border); backdrop-filter: blur(12px); }
    .nav-wrap { max-width: 960px; height: 58px; padding: 0 24px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; gap: 24px; }
    .name { color: var(--color-heading); font-size: 1.02rem; font-weight: 760; letter-spacing: -.02em; white-space: nowrap; }
    nav { display: flex; align-items: center; gap: 22px; }
    nav > a { color: var(--color-text); font-size: .86rem; font-weight: 650; }
    nav > a:hover { color: var(--color-primary); text-decoration: none; }
    @media (max-width: 760px) {
        .nav-wrap { height: 54px; }
        nav > a { display: none; }
    }
</style>
